<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$title</title>
<style>
body{font-family:-apple-system,"Segoe UI",Helvetica,Arial,sans-serif;color:#1f1f1f;background:#fff;margin:0 auto;padding:24px;max-width:1000px;line-height:1.5}
h1{font-size:1.6rem;margin:0 0 8px}
h2{font-size:1.25rem;border-bottom:2px solid #e3e3e3;padding-bottom:4px;margin-top:2rem}
h3{font-size:1.05rem;margin:1.4rem 0 .3rem}
h4{font-size:.95rem;margin:1rem 0 .3rem}
ul{margin:.3rem 0 .8rem;padding-left:1.3rem}
.banner{background:#fff4e5;border:1px solid #c2410c;border-left:6px solid #c2410c;padding:8px 12px;margin:8px 0;font-weight:600}
.tw{overflow-x:auto}
table{border-collapse:collapse;margin:.5rem 0 1rem;font-size:.88rem}
th,td{border:1px solid #d0d0d0;padding:4px 8px;text-align:left;vertical-align:top}
th{background:#f3f3f3}
td.sql{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.8rem;max-width:420px;word-break:break-all}
pre{background:#f6f6f6;border:1px solid #ddd;padding:8px;overflow-x:auto;font-size:.8rem;white-space:pre-wrap;word-break:break-word}
svg{display:block;max-width:100%;height:auto;margin:.8rem 0 .3rem}
ul.cap{list-style:none;padding:0;margin:0 0 1.2rem;font-size:.85rem;color:#444}
footer{margin-top:2.5rem;border-top:1px solid #ddd;padding-top:8px;font-size:.85rem;color:#444}
@media print{body{max-width:none;padding:0}}
</style>
</head>
<body>
<h1>$title</h1>
$banners
$body
</body>
</html>
